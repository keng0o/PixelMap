# Public DSN embedded in the app bundle. Leave empty to keep monitoring disabled.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Configure these as EAS build secrets/variables, never in a committed .env file.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
