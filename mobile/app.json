{
  "expo": {
    "name": "PixelMap",
    "slug": "pixelmap",
    "scheme": "pixelmap",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "現在地周辺の地図を表示するために、アプリ使用中の位置情報を利用します。"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/dotgothic16/400Regular/DotGothic16_400Regular.ttf"
          ]
        }
      ],
      "expo-splash-screen",
      "@sentry/react-native"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.pixelmap.mobile"
    },
    "android": {
      "package": "app.pixelmap.mobile",
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "7b973df6-6c7d-4894-a8ef-c3b3bcffcf6f"
      }
    },
    "owner": "neko07050922"
  }
}
